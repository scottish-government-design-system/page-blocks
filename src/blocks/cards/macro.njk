{#
    sgBlockThreeCards
    
    Renders a block to contain three card components.
    
    @param {Object} params - The options object for the block.
    @param {string} [params.background] - Optional background color for the block. Accepts 'secondary', 'tertiary', or 'theme'.
    @param {boolean} [params.removeBottomPadding=false] - If true, removes the bottom padding from the block.

    @example - Standard three cards block with secondary background
    {% call sgBlockThreeCards({ background: "secondary" }) %}
        <div class="ds_card">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 1</h2>
                </div>
            </div>
        </div>
        <div class="ds_card">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 2</h2>
                </div>
            </div>
        </div>
        <div class="ds_card">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 3</h2>
                </div>
            </div>
        </div>
    {% endcall %}

    @example - Three cards block with no background and no bottom padding, cards set to secondary background
    {% call sgBlockThreeCards({ removeBottomPadding: true }) %}
        <div class="ds_card  ds_card--background-secondary">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 1</h2>
                </div>
            </div>
        </div>
        <div class="ds_card  ds_card--background-tertiary">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 2</h2>
                </div>
            </div>
        </div>
        <div class="ds_card  ds_card--background-theme">
            <div class="ds_card__content">
                <div class="ds_card__content-header">
                    <h2 class="ds_card__title">Card 3</h2>
                </div>
            </div>
        </div>
    {% endcall %}
#}

{%- macro sgBlockThreeCards(params) -%}
<div class="ds_pb  ds_pb--cards
{%- if params.background == "secondary" %} ds_pb--background-secondary
{%- elseif params.background == "tertiary" %} ds_pb--background-tertiary
{%- elseif params.background == "theme" %} ds_pb__theme--background-secondary
{%- endif %}">
    <div class="ds_wrapper">    
        <div class="ds_pb__inner {%- if params.removeBottomPadding %}  ds_!_padding-bottom--0{% endif %}">
            {{ caller() }}     
        </div>
    </div>
</div>
{%- endmacro -%}