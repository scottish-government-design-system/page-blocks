{#
    sgBlockDoubleText

    Renders a block of two text/content columns.
    
    @param {Object} params - The options object for the block.
    @param {string} [params.background] - Optional background color for the block. Accepts 'secondary', 'tertiary', or 'theme'.
    @param {string} params.content - The main content for the first column.
    @param {string} [params.additionalContent] - Optional content for the second column.
    @param {boolean} [params.removeBottomPadding=false] - If true, removes the bottom padding from the block.

    @example - Standard double text block with default background
    {{ sgBlockDoubleText({ content: "<p>Main content here.</p>", additionalContent: "<p>Additional content here.</p>" }) }}

    @example - Double text block with secondary background and no bottom padding
    {{ sgBlockDoubleText({ background: "secondary", content: "<p>Main content here.</p>", additionalContent: "<p>Additional content here.</p>", removeBottomPadding: true }) }}
#}

{%- macro sgBlockDoubleText(params) -%}
<div class="ds_pb  ds_pb--double-text
{%- if params.background == "secondary" %} ds_pb--background-secondary
{%- elseif params.background == "tertiary" %} ds_pb--background-tertiary
{%- elseif params.background == "theme" %} ds_pb__theme--background-secondary
{%- endif %}">
    <div class="ds_wrapper">    
        <div class="ds_pb__inner {%- if params.removeBottomPadding %}  ds_!_padding-bottom--0{% endif %}">
            <div class="ds_pb__text">
                {{ params.content | safe }}
            </div>
            {%- if params.additionalContent %}
            <div class="ds_pb__text">
                {{ params.additionalContent | safe }}
            </div>
            {%- endif %}
        </div>
    </div>
</div>
{% endmacro %}