{
  "meta": {
    "description": "Scottish Government Design System page blocks for the GOV.UK Prototype Kit"
  },
  "stylesheets": [
    "/dist/css/page-blocks.css"
  ],
  "nunjucksPaths": [
    "/src/"
  ],
  {
  "importNunjucksMacrosInto": [
    "/nunjucks/sg-prototype-templates/layouts/_base-layout.njk"
  ],
  "nunjucksMacros": [
    {
      "macroName": "sgBlockDivider",
      "importFrom": "blocks/divider/macro.njk"
    }
  ],
  "pluginDependencies": [
	  {
	    "packageName": "@scottish-government/design-system",
      "minVersion": "4.2.0"
    },
    {
      "packageName": "@scottish-government-design-system/prototype-templates",
      "minVersion": "0.6.0"
    }
	]
}